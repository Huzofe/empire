# Production Environment Variables
# Копировать эти значения в Vercel/Render Environment Variables

# Database (будет автоматически из Vercel Postgres или Render PostgreSQL)
DATABASE_URL=${POSTGRES_URL_NON_POOLING}
DIRECT_URL=${POSTGRES_URL_NON_POOLING}

# NextAuth (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate-random-32-characters-use-openssl-rand-base64-32

# Encryption для API ключей (ОБЯЗАТЕЛЬНО ИЗМЕНИТЬ!)
ENCRYPTION_KEY=generate-random-32-chars-openssl-rand-hex-16

# Node Environment
NODE_ENV=production

# Optional: AI Providers (добавить если нужны)
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Как сгенерировать секреты:
# PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#
# Bash/Linux:
# openssl rand -base64 32
# openssl rand -hex 16
