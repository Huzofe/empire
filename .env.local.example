# Local Development Environment
# Копировать в .env.local для локальной разработки

# Database - PostgreSQL через Docker
DATABASE_URL="postgresql://empire:empirepass@localhost:5432/empire"
DIRECT_URL="postgresql://empire:empirepass@localhost:5432/empire"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-dev-secret-change-for-production"

# Encryption
ENCRYPTION_KEY="local-dev-key-change-for-prod-"

# Optional: AI Providers
GROQ_API_KEY=""
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
